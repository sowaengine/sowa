version: 1
resources:
  - id: 71001
    type: ImageTexture
    data: {path: "res://textures/spritesheet_tiles.png", filter: Nearest}
  - id: 71002
    type: ImageTexture
    data: {path: "res://textures/tile_334.png", filter: Nearest}
  - id: 71003
    type: PackedScene
    data: {path: "res://scenes/tilemap_coin.scene"}
root:
  name: TilemapExample
  components:
    SceneRoot:
      activeCamera: TilemapExample/Camera
  children:
    - name: Map
      components:
        Transform2D:
          position: [-576, -320]
        Tilemap:
          cellSize: [64, 64]
          sheets:
            - id: 1
              resource: 71001
              tileSize: [64, 64]
              margin: 0
              spacing: 10
              tiles:
                - {x: 0, y: 0, tile: 1}
                - {x: 20, y: 6, tile: 2}
          tiles:
            - {id: 1, name: Grass, resource: 71001, x: 0, y: 0, width: 64, height: 64}
            - {id: 2, name: Bush, resource: 71001, x: 1480, y: 444, width: 64, height: 64}
            - {id: 3, name: "Individual tile 334", resource: 71002}
            - {id: 4, name: Coin, resource: 71003, scene: true}
