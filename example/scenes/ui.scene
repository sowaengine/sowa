root:
  name: "UIDemo"
  components:
    SceneRoot:
      sourcePath: "res://scenes/ui.scene"
      activeCamera: "UIDemo/Camera"
    UIDemoController: {}
  children:
    - name: Camera
      components:
        Transform2D:
          position: [640, 360]
        Camera2D: {}
    -
      name: "Canvas"
      components:
        UICanvas:
          theme: 990102
          referenceSize:
            - 1280
            - 720
        Transform2D:
          position: [0, 720]
        UIRect:
          size: [1280, 720]
        UIPanel: {}
        UIStyle:
          variant: "Canvas"
      children:
        -
          name: "Title"
          components:
            UIRect:
              position:
                - 40
                - 30
              size:
                - 720
                - 44
            UILabel:
              text: "Build your game interface"
              fontSize: 34
        -
          name: "Subtitle"
          components:
            UIRect:
              position:
                - 40
                - 78
              size:
                - 850
                - 30
            UILabel:
              text: ""
              fontSize: 19
              modulate:
                - 0.7
                - 0.8
                - 0.95
                - 1
        -
          name: "Theme"
          components:
            UIRect:
              position:
                - -40
                - 35
              size:
                - 165
                - 40
              anchorMin:
                - 1
                - 0
              anchorMax:
                - 1
                - 0
              pivot:
                - 1
                - 0
            UIControl: {}
            UIButton:
              text: "Switch theme"
        -
          name: "Content"
          components:
            UIRect:
              position:
                - 40
                - 136
              size:
                - -80
                - -180
              anchorMax:
                - 1
                - 1
            UILayout:
