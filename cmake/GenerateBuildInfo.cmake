# Generate build_info.cpp on each build with Git hash, branch, and dirty status.
# Required arguments: IN_FILE, OUT_FILE, SOURCE_DIR, SOWA_VERSION.

set(GIT_COMMIT_HASH "unknown")
set(GIT_BRANCH "unknown")
set(GIT_IS_DIRTY "false")

find_package(Git QUIET)

if(GIT_EXECUTABLE)
  execute_process(
    COMMAND ${GIT_EXECUTABLE} rev-parse --abbrev-ref HEAD
    WORKING_DIRECTORY ${SOURCE_DIR}
    OUTPUT_VARIABLE GIT_BRANCH_OUT
    OUTPUT_STRIP_TRAILING_WHITESPACE
    ERROR_QUIET
    RESULT_VARIABLE GIT_BRANCH_RESULT
  )
  if(GIT_BRANCH_RESULT EQUAL 0 AND NOT GIT_BRANCH_OUT STREQUAL "")
    set(GIT_BRANCH "${GIT_BRANCH_OUT}")
  endif()

  execute_process(
    COMMAND ${GIT_EXECUTABLE} log -1 --format=%h
    WORKING_DIRECTORY ${SOURCE_DIR}
    OUTPUT_VARIABLE GIT_COMMIT_HASH_OUT
    OUTPUT_STRIP_TRAILING_WHITESPACE
    ERROR_QUIET
    RESULT_VARIABLE GIT_HASH_RESULT
  )
  if(GIT_HASH_RESULT EQUAL 0 AND NOT GIT_COMMIT_HASH_OUT STREQUAL "")
    set(GIT_COMMIT_HASH "${GIT_COMMIT_HASH_OUT}")
  endif()

  execute_process(
    COMMAND ${GIT_EXECUTABLE} status --porcelain
    WORKING_DIRECTORY ${SOURCE_DIR}
    OUTPUT_VARIABLE GIT_STATUS_PORCELAIN
    OUTPUT_STRIP_TRAILING_WHITESPACE
    ERROR_QUIET
    RESULT_VARIABLE GIT_STATUS_RESULT
  )
  if(GIT_STATUS_RESULT EQUAL 0 AND NOT GIT_STATUS_PORCELAIN STREQUAL "")
    set(GIT_IS_DIRTY "true")
  endif()
endif()

configure_file("${IN_FILE}" "${OUT_FILE}" @ONLY)
